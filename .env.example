# Copy thành .env và điền giá trị thật. Xem docs/DEPLOYMENT.md.
# BẮT BUỘC ở production (server từ chối khởi động nếu thiếu):
JWT_SECRET=doi-chuoi-ngau-nhien-dai-o-day

# Tùy chọn:
NODE_ENV=development
PORT=4000

# PostgreSQL (BẮT BUỘC): connection string cho database chính.
# Ví dụ local: postgres://educenter:educenter123@localhost:5432/educenter
DATABASE_URL=postgres://educenter:educenter123@localhost:5432/educenter
