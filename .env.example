# Copy thành .env và điền giá trị thật. Xem docs/DEPLOYMENT.md.
# BẮT BUỘC ở production (server từ chối khởi động nếu thiếu):
JWT_SECRET=doi-chuoi-ngau-nhien-dai-o-day

# Tùy chọn:
NODE_ENV=development
PORT=4000

# PostgreSQL (BẮT BUỘC): connection string cho database chính.
# Ví dụ local: postgres://educenter:educenter123@localhost:5432/educenter
DATABASE_URL=postgres://educenter:educenter123@localhost:5432/educenter
# Database cho test (npm test tự dùng):
# TEST_DATABASE_URL=postgres://educenter:educenter123@localhost:5432/educenter_test

# Seed dữ liệu demo (tài khoản root/teacher1/0900000001 + trung tâm demo).
# Mặc định TẮT. Chỉ bật 'true' ở môi trường dev/demo — KHÔNG BAO GIỜ bật ở production.
SEED_DEMO=false

# Tin header X-Forwarded-For cho rate limit chỉ khi chạy sau reverse proxy đáng tin.
# Mặc định false (rate limit theo IP socket, chống bypass bằng header giả).
TRUST_PROXY=false

# CORS allowlist, phân tách bằng dấu phẩy. Production đặt đúng domain frontend.
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# Backup tự động (pg_dump -Fc, chạy trong app bằng node-cron, múi giờ Asia/Ho_Chi_Minh):
# - Lịch cron (mặc định 2h sáng mỗi ngày)
BACKUP_CRON=0 2 * * *
# - Số bản backup giữ lại khi xoay vòng
BACKUP_KEEP=7
# Bản backup lưu tại ./backups/ (thư mục làm việc của server), tên educenter-backup-YYYYMMDD-HHMMSS.dump
