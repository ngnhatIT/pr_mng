# EduCenterPro — biến môi trường (copy thành .env và điền giá trị thật)
# Xem chi tiết: server/src/config/env.ts

NODE_ENV=development
PORT=4000

# PostgreSQL — BẮT BUỘC
DATABASE_URL=postgresql://educenter:mat-khau-manh@localhost:5432/educenter

# JWT — production BẮT BUỘC đặt secret riêng, đủ dài ngẫu nhiên
JWT_SECRET=doi-secret-ngau-nhien-du-dai-o-day
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Rate limit đăng nhập
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=60000

# Chạy sau reverse proxy đáng tin (nginx) thì bật để rate limit đọc IP thật
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# VNPay: TMN code + hash secret nhập per-center trong app (Cấu hình thanh toán), KHÔNG đặt ở đây.
# Env chỉ chọn môi trường (mặc định sandbox). Production:
#   VNPAY_PAY_URL=https://pay.vnpay.vn/vpcpay.html
#   VNPAY_API_URL=https://merchant.vnpay.vn/merchant_webapi/api/transaction
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Zalo OA: KHÔNG cấu hình qua env — nhập OA ID/token per-center ở trang Zalo trong app.

# Seed dữ liệu demo (mặc định TẮT — chỉ bật cho môi trường dev/test)
SEED_DEMO=false

# Backup tự động (cron) — chạy lúc 2h sáng, giữ 7 bản
BACKUP_CRON=0 2 * * *
BACKUP_KEEP=7
# Webhook nhận cảnh báo khi backup fail (optional)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...

# Database cho test — KHÔNG đọc từ file này: `npm test` chỉ đọc biến TEST_DATABASE_URL của SHELL
# (mặc định đúng giá trị dưới đây; tên DB phải kết thúc _test). Dòng này chỉ để tham khảo.
# TEST_DATABASE_URL=postgresql://educenter:educenter123@localhost:5432/educenter_test

# Base URL công khai (VNPay returnUrl). VD: https://app.educenter.vn — BẮT BUỘC ở production
APP_BASE_URL=

# Thư mục lưu file upload (bài tập, bài nộp). Mặc định <repo>/uploads. PHẢI nằm trong
# phạm vi backup/đồng bộ offsite (xem docs/DEPLOYMENT.md) — pg_dump không chứa file.
# UPLOAD_DIR=/var/lib/educenter/uploads

# Prometheus scrape GET /api/v1/metrics với header "Authorization: Bearer <METRICS_TOKEN>"
# (JWT superadmin hết hạn sau 15 phút nên không dùng được cho scraper). Rỗng = tắt. >= 32 ký tự,
# tạo bằng: openssl rand -hex 32. Mỗi worker PM2 trả số liệu riêng (label worker="...").
# METRICS_TOKEN=
